{
  "info": {
    "name": "Freelance Marketplace API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "gigId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "name", "value": "Ahmed Freelancer" },
                { "key": "email", "value": "ahmed@example.com" },
                { "key": "password", "value": "123456" },
                { "key": "role", "value": "freelancer" }
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@example.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Gigs",
      "item": [
        {
          "name": "Get All Gigs",
          "request": { "method": "GET", "url": "{{baseUrl}}/gigs" }
        },
        {
          "name": "Create Gig",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/gigs",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "title", "value": "I will design a logo" },
                { "key": "description", "value": "Professional logo design within 3 days" },
                { "key": "price", "value": "20" },
                { "key": "category", "value": "design" }
              ]
            }
          }
        },
        {
          "name": "Get Gig by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/gigs/{{gigId}}" }
        },
        {
          "name": "Delete Gig",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/gigs/{{gigId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gigId\": \"{{gigId}}\",\n  \"notes\": \"Please use blue color theme\"\n}"
            }
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/my",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/orders/{{orderId}}/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in-progress\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Create Review",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/reviews",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"rating\": 5,\n  \"comment\": \"Great work!\"\n}"
            }
          }
        },
        {
          "name": "Get Gig Reviews",
          "request": { "method": "GET", "url": "{{baseUrl}}/reviews/gig/{{gigId}}" }
        }
      ]
    }
  ]
}
